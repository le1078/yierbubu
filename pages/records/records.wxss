.page { padding: 24rpx 24rpx 40rpx; }

/* Tab 切换（三个 tab，字号与间距略收，保证单行放得下） */
.tab-bar {
  display: flex; gap: 10rpx; margin-bottom: 24rpx;
}
.tab-item {
  flex: 1; text-align: center; padding: 18rpx 0;
  border-radius: 999rpx; background: #F5F0EB; color: #8A7E78;
  font-size: 25rpx; font-weight: 600; white-space: nowrap;
}
.tab-item.active {
  background: linear-gradient(135deg, #FF8FAB, #FF5A5F);
  color: #FFFFFF;
  box-shadow: 0 4rpx 12rpx rgba(255, 90, 95, 0.3);
}

.rec-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 24rpx; }
.rec-head .rh { font-size: 32rpx; font-weight: 800; color: #2B2B2B; }
.clear-btn { font-size: 24rpx; color: #FF5A5F; background: #FFEFEF; border: none; padding: 14rpx 24rpx; border-radius: 999rpx; }

/* 头部操作区 */
.head-actions { display: flex; align-items: center; gap: 16rpx; }
.trash-btn {
  display: flex; align-items: center; gap: 6rpx;
  font-size: 24rpx; color: #8A7E78; background: #F5F0EB;
  padding: 14rpx 24rpx; border-radius: 999rpx; position: relative;
}
.trash-badge {
  min-width: 32rpx; height: 32rpx; padding: 0 8rpx; box-sizing: border-box;
  background: #FF5A5F; color: #fff; font-size: 20rpx; font-weight: 700;
  border-radius: 999rpx; display: flex; align-items: center; justify-content: center;
}

/* 单条删除按钮 */
.del-btn {
  font-size: 22rpx; color: #FF5A5F; background: #FFEFEF; border: none;
  padding: 8rpx 18rpx; border-radius: 999rpx; flex-shrink: 0; line-height: 1.4;
}
.del-btn::after { border: none; }
.rec-item .del-btn { margin-left: 4rpx; }

.empty-box { text-align: center; padding: 60rpx 0; }
.empty-img { width: 200rpx; height: 200rpx; margin: 0 auto 24rpx; display: block; border-radius: 50%; background: #FFF9FA; padding: 12rpx; box-sizing: border-box; }
.empty-tip { color: #4A3F3A; font-size: 30rpx; font-weight: 700; margin-bottom: 10rpx; }
.empty-sub { color: #8A7E78; font-size: 26rpx; }

/* 批量分组 */
.rec-group { background: #fff; border-radius: 24rpx; padding: 20rpx 24rpx; margin-bottom: 16rpx; border: 3rpx solid #F0E2D8; }
.rg-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 16rpx; }
.rg-title { display: flex; align-items: center; flex-wrap: wrap; gap: 10rpx; }
.rg-right { display: flex; align-items: center; gap: 12rpx; flex-shrink: 0; }
.rg-subtitle { font-size: 28rpx; font-weight: 800; color: #2B2B2B; }
.rg-head .ri-time { font-size: 22rpx; color: #8A7E78; font-weight: 400; }
.rg-chips { display: flex; flex-wrap: wrap; gap: 12rpx; }
.rec-chip { color: #fff; font-size: 24rpx; font-weight: 700; padding: 8rpx 20rpx; border-radius: 999rpx; font-variant-numeric: tabular-nums; }

/* 来源徽标 */
.kind-pill {
  display: inline-block; font-size: 22rpx; font-weight: 800; color: #fff;
  padding: 4rpx 16rpx; border-radius: 999rpx; white-space: nowrap;
  background: linear-gradient(135deg, #FFB6C9, #FF8FAB);
}
.kind-pill.k-shake { background: linear-gradient(135deg, #FFB6C9, #FF8FAB); }
.kind-pill.k-scratch { background: linear-gradient(135deg, #FFD27D, #FFB23E); }
.kind-pill.sm { font-size: 20rpx; padding: 2rpx 12rpx; align-self: flex-start; }

.rec-item {
  display: flex; align-items: center; gap: 20rpx; background: #fff;
  border-radius: 24rpx; padding: 20rpx 24rpx; margin-bottom: 16rpx; border: 3rpx solid #F0E2D8;
}
.rec-item .re { font-size: 60rpx; }
.ri-main { flex: 1; }
.ri-name { font-size: 28rpx; font-weight: 700; color: #4A3F3A; }
.ri-time { font-size: 22rpx; color: #8A7E78; margin-top: 4rpx; }
.ri-num { font-size: 36rpx; font-weight: 800; color: #fff; padding: 4rpx 24rpx; border-radius: 999rpx; font-variant-numeric: tabular-nums; }

/* 吃饭记录卡片 */
.order-card {
  background: #fff; border-radius: 20rpx; padding: 24rpx;
  margin-bottom: 20rpx; border: 3rpx solid #F0E2D8;
}
.oc-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 12rpx; gap: 16rpx; }
.oc-left { display: flex; align-items: center; gap: 12rpx; flex-wrap: wrap; min-width: 0; }
.oc-time { font-size: 24rpx; color: #A08A80; }
.oc-status { font-size: 22rpx; color: #52C41A; background: #F6FFED; padding: 4rpx 16rpx; border-radius: 999rpx; }
.oc-items { margin-bottom: 12rpx; }
.oc-dish { font-size: 26rpx; color: #4A3F3A; line-height: 1.6; }
.oc-dish-price { color: #FF5A5F; font-size: 24rpx; }
/* 底部行：备注左对齐 + 合计右对齐，备注超长自动换行 */
.oc-footer {
  display: flex; justify-content: space-between; align-items: flex-end;
  border-top: 2rpx solid #F5F0EB; padding-top: 12rpx; gap: 16rpx;
}
.oc-remark {
  flex: 1; font-size: 24rpx; color: #8A7E78; line-height: 1.5;
  word-break: break-all; min-width: 0;
}
.oc-total { flex-shrink: 0; font-size: 26rpx; color: #4A3F3A; margin-left: auto; }
.oc-total-num { font-size: 32rpx; font-weight: 700; color: #FF5A5F; }

/* ===== 购物记录卡片 ===== */
.shop-card {
  background: #fff; border-radius: 20rpx; padding: 24rpx;
  margin-bottom: 20rpx; border: 3rpx solid #F0E2D8;
}
.shop-card.done { background: #FCFBF9; border-color: #F0EAE6; }

.sc-header {
  display: flex; justify-content: space-between; align-items: center;
  gap: 16rpx; margin-bottom: 14rpx;
}
.sc-left { display: flex; align-items: center; gap: 14rpx; min-width: 0; flex-wrap: wrap; }
.sc-plat { font-size: 22rpx; font-weight: 700; }
.sc-date { font-size: 22rpx; color: #A08A80; }

.sc-body { display: flex; align-items: flex-start; gap: 16rpx; }
.sc-title {
  flex: 1; min-width: 0; font-size: 28rpx; font-weight: 600;
  color: #4A3F3A; line-height: 1.5; word-break: break-all;
}
.shop-card.done .sc-title { color: #B0A39C; text-decoration: line-through; }
.sc-price {
  flex-shrink: 0; font-size: 30rpx; font-weight: 800; color: #E2547A;
}
.shop-card.done .sc-price { color: #C4B5AE; }

.sc-note {
  margin-top: 12rpx; padding: 12rpx 16rpx;
  background: #FFFBF2; border: 2rpx solid #F6EBD6; border-radius: 12rpx;
  font-size: 22rpx; color: #A08A80; line-height: 1.5; word-break: break-all;
}
.shop-card.done .sc-note { background: #FBF9F6; border-color: #F0EAE4; }

.sc-footer {
  margin-top: 14rpx; padding-top: 12rpx;
  border-top: 2rpx solid #F5F0EB;
  display: flex; align-items: center; justify-content: space-between; gap: 16rpx;
}
.sc-tag {
  font-size: 20rpx; color: #C08ACF; background: #F8F0FF;
  padding: 4rpx 14rpx; border-radius: 999rpx;
}
.sc-state { font-size: 22rpx; color: #FF9B4A; margin-left: auto; }
.sc-state.bought { color: #52C41A; }

/* ===== 回收站弹层 ===== */
.trash-mask {
  position: fixed; left: 0; right: 0; top: 0; bottom: 0;
  background: rgba(43, 43, 43, 0.45); z-index: 100;
  display: flex; align-items: flex-end; justify-content: center;
}
.trash-panel {
  width: 100%; max-height: 80vh; background: #FFFDFC;
  border-radius: 32rpx 32rpx 0 0; display: flex; flex-direction: column;
  overflow: hidden; padding-bottom: env(safe-area-inset-bottom);
}
.tp-head {
  flex: none; display: flex; align-items: center; justify-content: space-between;
  padding: 28rpx 32rpx 16rpx; border-bottom: 2rpx solid #F5F0EB;
}
.tp-title { font-size: 32rpx; font-weight: 800; color: #2B2B2B; }
.tp-acts { display: flex; align-items: center; gap: 20rpx; }
.tp-clear {
  font-size: 24rpx; color: #FF5A5F; background: #FFEFEF;
  padding: 8rpx 18rpx; border-radius: 999rpx;
}
.tp-close { font-size: 32rpx; color: #8A7E78; padding: 0 8rpx; line-height: 1; }
.tp-tip { flex: none; font-size: 22rpx; color: #A08A80; padding: 16rpx 32rpx 8rpx; }
.tp-body { flex: 1; min-height: 0; padding: 8rpx 32rpx 32rpx; }

.tp-empty { text-align: center; padding: 60rpx 0 80rpx; }
.tp-empty-img { width: 160rpx; height: 160rpx; margin: 0 auto 20rpx; display: block; border-radius: 50%; background: #FFF9FA; padding: 12rpx; box-sizing: border-box; }
.tp-empty-tip { color: #8A7E78; font-size: 26rpx; }

.tp-item {
  display: flex; align-items: center; gap: 20rpx;
  background: #fff; border: 3rpx solid #F0E2D8; border-radius: 20rpx;
  padding: 20rpx 24rpx; margin-bottom: 16rpx;
}
.tp-item-main { flex: 1; min-width: 0; }
.tp-item-title { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; font-size: 26rpx; font-weight: 700; color: #4A3F3A; }
.tp-item-amt { font-size: 26rpx; font-weight: 800; color: #FF5A5F; flex-shrink: 0; }
.tp-item-desc { font-size: 24rpx; color: #8A7E78; line-height: 1.5; margin-top: 6rpx; word-break: break-all; }
.tp-item-time { font-size: 22rpx; color: #C4B4AC; margin-top: 6rpx; }
.tp-item-acts { flex-shrink: 0; display: flex; flex-direction: column; gap: 12rpx; }
.tp-restore, .tp-purge {
  font-size: 22rpx; text-align: center; padding: 8rpx 20rpx; border-radius: 999rpx; line-height: 1.4;
}
.tp-restore { color: #52C41A; background: #F6FFED; }
.tp-purge { color: #FF5A5F; background: #FFEFEF; }
