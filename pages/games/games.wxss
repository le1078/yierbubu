.page {
  min-height: 100vh;
  padding: 24rpx;
}

.hero {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: linear-gradient(135deg, #FFE3EC, #FFF3D9);
  border-radius: 28rpx;
  padding: 28rpx 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(255, 143, 171, 0.18);
}

.hero-masc {
  width: 120rpx;
  height: 120rpx;
}

.hero-text {
  flex: 1;
  text-align: center;
}

.hero-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #E2547A;
}

.hero-sub {
  margin-top: 10rpx;
  font-size: 26rpx;
  color: #A08A80;
}

.list {
  margin-top: 32rpx;
}

.gcard {
  display: flex;
  align-items: center;
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 28rpx 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 6rpx 20rpx rgba(74, 63, 58, 0.08);
  border: 2rpx solid #FCE8EF;
}

.gcard:active {
  transform: scale(0.98);
}

.gcard.soon {
  opacity: 0.55;
}

.gicon {
  width: 96rpx;
  height: 96rpx;
  border-radius: 20rpx;
  background: #FFF0F4;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  line-height: 1;
  overflow: hidden;
  flex-shrink: 0;
}

.ginfo {
  flex: 1;
  margin-left: 24rpx;
}

.gname {
  font-size: 32rpx;
  font-weight: 600;
  color: #4A3F3A;
  display: flex;
  align-items: center;
  flex-wrap: wrap;
}

.gtag {
  font-size: 20rpx;
  font-weight: 400;
  color: #FFFFFF;
  background: #FF8FAB;
  border-radius: 999rpx;
  padding: 4rpx 14rpx;
  margin-left: 12rpx;
}

.gtag.dim {
  background: #C9BFB9;
}

.gdesc {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #A08A80;
}

.ggo {
  font-size: 48rpx;
  color: #FF8FAB;
  flex-shrink: 0;
  margin-left: 12rpx;
}

.tip {
  margin-top: 40rpx;
  text-align: center;
  font-size: 22rpx;
  color: #C4B5AE;
  line-height: 1.6;
}
