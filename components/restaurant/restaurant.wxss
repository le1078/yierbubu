/* 小笨餐厅 · 粉色系风格（作为小笨生活内嵌组件） */

.rest-page {
  padding-bottom: 160rpx;
  background: transparent;
}

/* ===== 餐厅牌子 ===== */
.signboard {
  padding: 32rpx 24rpx 0;
}

.sign-frame {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: linear-gradient(135deg, #FFE3EC, #FFF3D9);
  border-radius: 32rpx;
  padding: 32rpx 24rpx;
  box-shadow: 0 12rpx 32rpx rgba(255, 143, 171, 0.25);
  border: 3rpx solid #FF8FAB;
  position: relative;
  overflow: hidden;
}

.sign-frame::before {
  content: '';
  position: absolute;
  top: -20rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 200rpx;
  height: 8rpx;
  background: #FF5A5F;
  border-radius: 0 0 8rpx 8rpx;
}

.chef {
  width: 140rpx;
  height: 140rpx;
  flex-shrink: 0;
}

.sign-content {
  text-align: center;
  flex: 1;
  padding: 0 16rpx;
}

.sign-title {
  font-size: 52rpx;
  font-weight: 900;
  color: #E2547A;
  text-shadow: 2rpx 2rpx 0 #FFF;
  letter-spacing: 4rpx;
}

.sign-sub {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #A08A80;
}

.sign-date {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #C4B5AE;
}

/* ===== 菜单区 ===== */
.menu-section {
  padding: 32rpx 24rpx;
}

.menu-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #4A3F3A;
  margin-bottom: 24rpx;
}

.cat-tabs {
  display: flex;
  white-space: nowrap;
  margin-bottom: 24rpx;
  gap: 16rpx;
}

.cat-tab {
  display: inline-block;
  padding: 16rpx 32rpx;
  border-radius: 999rpx;
  background: #F5F0EB;
  color: #8A7E78;
  font-size: 26rpx;
  flex-shrink: 0;
}

.cat-tab.active {
  background: linear-gradient(135deg, #FF8FAB, #FF5A5F);
  color: #FFFFFF;
  font-weight: 600;
  box-shadow: 0 4rpx 12rpx rgba(255, 90, 95, 0.3);
}

/* ===== 菜品卡片 ===== */
.dish-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.dish-card {
  display: flex;
  align-items: center;
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 24rpx;
  box-shadow: 0 6rpx 20rpx rgba(74, 63, 58, 0.08);
  border: 2rpx solid #FCE8EF;
}

.dish-emoji {
  font-size: 64rpx;
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #FFF0F4;
  border-radius: 16rpx;
  flex-shrink: 0;
}

.dish-info {
  flex: 1;
  margin-left: 20rpx;
  min-width: 0;
}

.dish-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #4A3F3A;
}

.dish-desc {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #A08A80;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.dish-price {
  margin-top: 8rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: #FF5A5F;
}

.dish-actions {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-shrink: 0;
}

.dish-btn {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 600;
}

.dish-btn.plus {
  background: linear-gradient(135deg, #FF8FAB, #FF5A5F);
  color: #FFFFFF;
  box-shadow: 0 4rpx 8rpx rgba(255, 90, 95, 0.3);
}

.dish-btn.minus {
  background: #F5F0EB;
  color: #8A7E78;
}

.dish-count {
  min-width: 40rpx;
  text-align: center;
  font-size: 28rpx;
  font-weight: 600;
  color: #4A3F3A;
}

/* ===== 底部购物车栏 ===== */
.cart-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: #FFFFFF;
  border-top: 2rpx solid #F0E4DE;
  box-shadow: 0 -4rpx 20rpx rgba(74, 63, 58, 0.08);
  z-index: 50;
}

.cart-bar.has-items {
  background: linear-gradient(135deg, #FFF0F4, #FFFFFF);
}

.cart-left {
  position: relative;
  margin-right: 20rpx;
}

.cart-icon {
  font-size: 48rpx;
}

.cart-badge {
  position: absolute;
  top: -8rpx;
  right: -12rpx;
  background: #FF5A5F;
  color: #FFFFFF;
  font-size: 20rpx;
  min-width: 32rpx;
  height: 32rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 8rpx;
}

.cart-total {
  flex: 1;
  font-size: 32rpx;
  font-weight: 700;
  color: #FF5A5F;
}

.cart-total.empty {
  color: #C4B5AE;
  font-weight: 400;
}

.cart-submit {
  background: #F5F0EB;
  color: #C4B5AE;
  border-radius: 999rpx;
  padding: 18rpx 48rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.cart-submit.active {
  background: linear-gradient(135deg, #FF8FAB, #FF5A5F);
  color: #FFFFFF;
  box-shadow: 0 8rpx 16rpx rgba(255, 90, 95, 0.3);
}

/* ===== 购物车展开面板 ===== */
.cart-panel-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 100;
  display: flex;
  align-items: flex-end;
}

.cart-panel {
  width: 100%;
  background: #FFFDF8;
  border-radius: 32rpx 32rpx 0 0;
  padding: 32rpx 24rpx;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
  max-height: 70vh;
  display: flex;
  flex-direction: column;
}

.cp-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.cp-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #4A3F3A;
}

.cp-close {
  font-size: 32rpx;
  color: #C4B5AE;
  padding: 8rpx;
}

.cp-list {
  flex: 1;
  max-height: 400rpx;
}

.cp-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 2rpx solid #F5F0EB;
}

.cp-item-info {
  display: flex;
  flex-direction: column;
}

.cp-item-name {
  font-size: 28rpx;
  color: #4A3F3A;
}

.cp-item-price {
  font-size: 22rpx;
  color: #A08A80;
  margin-top: 4rpx;
}

.cp-item-sub {
  font-size: 28rpx;
  font-weight: 600;
  color: #FF5A5F;
}

.cp-footer {
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 2rpx solid #F5F0EB;
}

.cp-input {
  background: #FFF8F5;
  border: 2rpx solid #FCE8EF;
  border-radius: 999rpx;
  padding: 18rpx 28rpx;
  font-size: 26rpx;
  color: #4A3F3A;
  margin-bottom: 20rpx;
}

.cp-total-row {
  display: flex;
  justify-content: flex-end;
  align-items: baseline;
  margin-bottom: 20rpx;
  font-size: 26rpx;
  color: #4A3F3A;
}

.cp-total {
  font-size: 40rpx;
  font-weight: 700;
  color: #FF5A5F;
  margin-left: 8rpx;
}

.cp-submit {
  background: #F5F0EB;
  color: #C4B5AE;
  border-radius: 999rpx;
  padding: 22rpx 0;
  text-align: center;
  font-size: 30rpx;
  font-weight: 600;
}

.cp-submit.active {
  background: linear-gradient(135deg, #FF8FAB, #FF5A5F);
  color: #FFFFFF;
  box-shadow: 0 8rpx 16rpx rgba(255, 90, 95, 0.3);
}

/* ===== 订单记录入口 ===== */
.orders-entry {
  margin: 32rpx 24rpx;
  padding: 24rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  text-align: center;
  font-size: 28rpx;
  color: #4A3F3A;
  box-shadow: 0 6rpx 20rpx rgba(74, 63, 58, 0.08);
  border: 2rpx solid #FCE8EF;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
}

.orders-count {
  background: #FF8FAB;
  color: #FFFFFF;
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
}

/* ===== 订单记录面板 ===== */
.orders-panel-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 100;
  display: flex;
  align-items: flex-end;
}

.orders-panel {
  width: 100%;
  background: #FFFDF8;
  border-radius: 32rpx 32rpx 0 0;
  padding: 32rpx 24rpx;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
  max-height: 80vh;
  display: flex;
  flex-direction: column;
}

.op-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.op-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #4A3F3A;
}

.op-clear {
  font-size: 24rpx;
  color: #FF5A5F;
  padding: 8rpx 16rpx;
}

.op-close {
  font-size: 32rpx;
  color: #C4B5AE;
  padding: 8rpx;
}

.op-list {
  flex: 1;
}

.order-card {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(74, 63, 58, 0.06);
  border: 2rpx solid #FCE8EF;
}

.oc-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.oc-time {
  font-size: 24rpx;
  color: #A08A80;
}

.oc-status {
  font-size: 22rpx;
  color: #52C41A;
  background: #F6FFED;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
}

.oc-table {
  font-size: 24rpx;
  color: #8A7E78;
  margin-bottom: 12rpx;
}

.oc-items {
  margin-bottom: 12rpx;
}

.oc-dish {
  font-size: 26rpx;
  color: #4A3F3A;
  line-height: 1.6;
}

.oc-dish-price {
  color: #FF5A5F;
  font-size: 24rpx;
}

.oc-total {
  text-align: right;
  font-size: 26rpx;
  color: #4A3F3A;
  border-top: 2rpx solid #F5F0EB;
  padding-top: 12rpx;
}

.oc-total-num {
  font-size: 32rpx;
  font-weight: 700;
  color: #FF5A5F;
}

.op-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 0;
}

.op-empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.op-empty-text {
  font-size: 26rpx;
  color: #C4B5AE;
}

/* ===== 菜单编辑按钮 ===== */
.menu-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.menu-edit-btn {
  background: linear-gradient(135deg, #FF8FAB, #FF5A5F);
  color: #FFFFFF;
  font-size: 24rpx;
  padding: 12rpx 28rpx;
  border-radius: 999rpx;
  box-shadow: 0 4rpx 12rpx rgba(255, 90, 95, 0.3);
}

/* ===== 菜品口味 ===== */
.dish-taste {
  margin-top: 4rpx;
  font-size: 20rpx;
  color: #FF8FAB;
}

/* ===== 购物车面板 textarea ===== */
.cp-textarea {
  width: 100%;
  min-height: 120rpx;
  background: #FFF8F5;
  border: 2rpx solid #FCE8EF;
  border-radius: 16rpx;
  padding: 22rpx 24rpx;
  font-size: 28rpx;
  color: #4A3F3A;
  margin-bottom: 20rpx;
  box-sizing: border-box;
  line-height: 1.5;
}

/* ===== 菜单编辑面板 ===== */
.editor-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 100;
  display: flex;
  align-items: flex-end;
}

.editor-panel {
  width: 100%;
  background: #FFFDF8;
  border-radius: 32rpx 32rpx 0 0;
  padding: 32rpx 24rpx;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
  max-height: 85vh;
  overflow-y: auto;
}

.ep-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.ep-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #4A3F3A;
}

.ep-close {
  font-size: 32rpx;
  color: #C4B5AE;
  padding: 8rpx;
}

.ep-section {
  margin-bottom: 28rpx;
}

.ep-label {
  font-size: 26rpx;
  font-weight: 600;
  color: #4A3F3A;
  margin-bottom: 16rpx;
}

.ep-cat-tabs {
  display: flex;
  white-space: nowrap;
  gap: 12rpx;
}

.cat-tab.sm {
  padding: 12rpx 24rpx;
  font-size: 24rpx;
}

.ep-dish-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.ep-dish-item {
  display: flex;
  align-items: center;
  background: #FFF8F5;
  border-radius: 16rpx;
  padding: 16rpx 20rpx;
  border: 2rpx solid #FCE8EF;
}

.ep-dish-emoji {
  font-size: 40rpx;
  margin-right: 16rpx;
}

.ep-dish-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.ep-dish-name {
  font-size: 26rpx;
  font-weight: 600;
  color: #4A3F3A;
}

.ep-dish-price {
  font-size: 22rpx;
  color: #FF5A5F;
}

.ep-dish-edit {
  font-size: 24rpx;
  color: #FF8FAB;
  padding: 8rpx 16rpx;
}

.ep-form {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.ep-input {
  background: #FFF8F5;
  border: 2rpx solid #FCE8EF;
  border-radius: 16rpx;
  padding: 22rpx 24rpx;
  font-size: 28rpx;
  color: #4A3F3A;
  height: 88rpx;
  line-height: 44rpx;
  box-sizing: border-box;
}

.ep-textarea {
  min-height: 120rpx;
  height: auto;
  line-height: 1.5;
}

.ep-form-btns {
  display: flex;
  gap: 16rpx;
  margin-top: 8rpx;
}

.ep-btn {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.ep-btn.primary {
  background: linear-gradient(135deg, #FF8FAB, #FF5A5F);
  color: #FFFFFF;
}

.ep-btn.ghost {
  background: #F5F0EB;
  color: #A08A80;
}

.ep-btn.danger {
  background: #FFEFEF;
  color: #FF5A5F;
}

/* ===== 菜品图片 ===== */
.dish-img-wrap {
  width: 80rpx;
  height: 80rpx;
  border-radius: 16rpx;
  overflow: hidden;
  flex-shrink: 0;
  background: #FFF0F4;
}

.dish-img {
  width: 100%;
  height: 100%;
}

/* ===== 购物车面板菜品图片 ===== */
.cp-item-info {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex: 1;
}

.cp-item-img {
  width: 64rpx;
  height: 64rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
}

.cp-item-emoji {
  font-size: 48rpx;
  flex-shrink: 0;
}

.cp-item-text {
  display: flex;
  flex-direction: column;
}

/* ===== 编辑面板滚动 ===== */
.ep-scroll {
  max-height: 70vh;
}

/* ===== 分类管理 ===== */
.ep-cat-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.ep-cat-item {
  display: flex;
  align-items: center;
  background: #F5F0EB;
  border-radius: 999rpx;
  padding: 8rpx 16rpx;
  gap: 8rpx;
  border: 2rpx solid transparent;
}

.ep-cat-item.active {
  background: linear-gradient(135deg, #FF8FAB, #FF5A5F);
  border-color: #FF5A5F;
}

.ep-cat-item.active .ep-cat-name-input {
  color: #FFFFFF;
}

.ep-cat-name-input {
  font-size: 24rpx;
  color: #4A3F3A;
  min-width: 80rpx;
  max-width: 160rpx;
  background: transparent;
  border: none;
  padding: 0;
  text-align: center;
}

.ep-cat-del {
  font-size: 20rpx;
  color: #C4B5AE;
  padding: 0 4rpx;
  line-height: 1;
}

.ep-cat-item.active .ep-cat-del {
  color: rgba(255,255,255,0.8);
}

.ep-add-cat {
  display: inline-block;
  padding: 12rpx 28rpx;
  background: #FFF0F4;
  color: #FF8FAB;
  border-radius: 999rpx;
  font-size: 24rpx;
  border: 2rpx dashed #FF8FAB;
}

/* ===== 菜品图片上传 ===== */
.ep-img-section {
  margin-bottom: 16rpx;
}

.ep-img-label {
  font-size: 24rpx;
  color: #A08A80;
  margin-bottom: 12rpx;
}

.ep-img-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.ep-img-preview {
  position: relative;
  width: 120rpx;
  height: 120rpx;
  border-radius: 16rpx;
  overflow: hidden;
}

.ep-img-thumb {
  width: 100%;
  height: 100%;
}

.ep-img-del {
  position: absolute;
  top: 4rpx;
  right: 4rpx;
  width: 32rpx;
  height: 32rpx;
  background: rgba(0,0,0,0.5);
  color: #FFF;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
}

.ep-img-upload {
  width: 140rpx;
  height: 140rpx;
  background: #FFF8F5;
  border: 2rpx dashed #FF8FAB;
  border-radius: 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  flex-shrink: 0;
}

.ep-img-upload-icon {
  font-size: 48rpx;
}

.ep-img-upload-text {
  font-size: 22rpx;
  color: #FF8FAB;
}

.ep-emoji-input {
  width: 140rpx;
  height: 88rpx;
  line-height: 44rpx;
  text-align: center;
}

/* ===== 编辑面板 textarea ===== */
.ep-textarea {
  min-height: 120rpx;
  height: auto;
  line-height: 1.5;
}
