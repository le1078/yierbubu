/* 号码下注 · 配色与首页来财页一致（奶油底 / 珊瑚红 / 粉色虚线圆角）
   换算基准：网页 1px = 2rpx */

.bt, .bt view, .bt text, .bt image, .bt input, .bt scroll-view {
  box-sizing: border-box;
}

.bt {
  padding: 8rpx 0 24rpx;
  color: #4A3F3A;
  font-size: 26rpx;
  line-height: 1.55;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
}

/* ---------- 顶部说明 ---------- */
.bt-hint {
  background: #FFF9FA;
  border: 3rpx dashed #FFE3D3;
  border-radius: 24rpx;
  padding: 16rpx 20rpx;
  font-size: 23rpx;
  line-height: 1.7;
  color: #A9743F;
  margin-bottom: 16rpx;
}
.bt-b { color: #FF5A5F; font-weight: 800; }

/* ---------- 卡片 ---------- */
.bt-card {
  background: #fff;
  border: 3rpx solid #FFD9E3;
  border-radius: 28rpx;
  padding: 22rpx;
  box-shadow: 0 12rpx 28rpx rgba(255, 138, 171, 0.14);
  margin-bottom: 16rpx;
}
.bt-ct {
  display: flex;
  align-items: center;
  font-size: 25rpx;
  font-weight: 900;
  color: #A9743F;
  letter-spacing: 0.5rpx;
  margin-bottom: 18rpx;
}
.bt-ct.sub { margin-top: 26rpx; }
.bt-dot {
  width: 12rpx; height: 12rpx; border-radius: 50%;
  background: #FF5A5F; margin-right: 12rpx; flex: none;
  box-shadow: 0 0 0 5rpx rgba(255, 90, 95, 0.12);
}
.bt-cnt { font-weight: 800; color: #BCA89C; margin-left: 8rpx; font-size: 22rpx; }

/* ---------- 回合 ---------- */
.bt-roundtop { display: flex; align-items: flex-end; }
.bt-roundno { font-size: 23rpx; color: #BCA89C; font-weight: 700; }
.bt-cdwrap { margin-left: auto; display: flex; align-items: baseline; }
.bt-cd {
  font-size: 62rpx; font-weight: 900; line-height: 1;
  color: #FF5A5F; font-variant-numeric: tabular-nums;
}
.bt-cd.urgent { color: #E8543F; }
.bt-phase { font-size: 21rpx; color: #BCA89C; font-weight: 800; margin-left: 12rpx; }

.bt-bar {
  height: 14rpx; border-radius: 99rpx; background: #FBEAE0;
  overflow: hidden; margin-top: 20rpx; border: 2rpx solid #F7DFD2;
}
.bt-barfill {
  height: 100%; border-radius: 99rpx;
  background: linear-gradient(90deg, #FF8FAB, #FF5A5F);
  transition: width 0.1s linear;
}
.bt-bar.closed .bt-barfill { background: linear-gradient(90deg, #FFC2B0, #E8543F); }

.bt-interval { display: flex; align-items: center; flex-wrap: wrap; margin-top: 18rpx; }
.bt-ilabel { font-size: 22rpx; color: #BCA89C; font-weight: 800; margin-right: 12rpx; }
.bt-ichip {
  font-size: 22rpx; font-weight: 800; color: #A9743F;
  background: #fff; border: 2rpx solid #FFE3D3; border-radius: 99rpx;
  padding: 8rpx 18rpx; margin-right: 10rpx; margin-bottom: 8rpx;
}
.bt-ichip.on {
  color: #fff; border-color: #FF5A5F;
  background: linear-gradient(135deg, #FF5A5F, #FF7A5C);
  box-shadow: 0 6rpx 14rpx rgba(255, 90, 95, 0.24);
}

.bt-stage {
  display: flex; align-items: center;
  margin-top: 18rpx; padding: 18rpx;
  background: linear-gradient(135deg, #FFFDF8, #FFF2F6);
  border: 3rpx dashed #FFD9E3; border-radius: 24rpx;
}
.bt-ball {
  width: 130rpx; height: 130rpx; border-radius: 50%; flex: none;
  display: flex; align-items: center; justify-content: center;
  font-size: 46rpx; font-weight: 900; font-variant-numeric: tabular-nums;
  color: #B23A44; border: 4rpx solid #fff;
  background: radial-gradient(circle at 32% 26%, #fff, #FFD9E3 58%, #FF9BB3);
  box-shadow: 0 12rpx 26rpx rgba(255, 138, 171, 0.35);
}
.bt-ball.idle {
  color: #C3AFA3;
  background: radial-gradient(circle at 32% 26%, #fff, #F7EDE6 60%, #EEDCD0);
  box-shadow: none;
}
.bt-ball.rolling { animation: bt-tumble 0.6s ease-in-out infinite; }
.bt-ball.win { animation: bt-pop 0.45s cubic-bezier(0.2, 1.6, 0.4, 1); }
@keyframes bt-tumble {
  0%, 100% { transform: rotate(-6deg) scale(1); }
  50% { transform: rotate(6deg) scale(1.04); }
}
@keyframes bt-pop {
  0% { transform: scale(0.7); }
  60% { transform: scale(1.12); }
  100% { transform: scale(1); }
}

.bt-sayer { flex: 1; min-width: 0; display: flex; align-items: center; margin-left: 16rpx; }
.bt-face {
  width: 96rpx; height: 96rpx; border-radius: 50%; flex: none;
  background: #fff; border: 3rpx solid #FFE3D3;
  box-shadow: 0 8rpx 18rpx rgba(255, 138, 171, 0.14);
}
.bt-bubble {
  position: relative; margin-left: 14rpx; flex: 1;
  background: #fff; border: 3rpx solid #FFE3D3; border-radius: 20rpx;
  padding: 12rpx 16rpx; font-size: 23rpx; font-weight: 700; color: #4A3F3A;
  line-height: 1.5;
}
.bt-result { margin-top: 14rpx; font-size: 23rpx; font-weight: 800; }
.bt-result.win { color: #3FBF8F; }
.bt-result.lose { color: #BCA89C; }

/* ---------- 生肖 / 号码 ---------- */
.bt-zgrid { display: flex; flex-wrap: wrap; }
.bt-zbtn {
  position: relative;
  width: calc((100% - 50rpx) / 6);
  margin: 0 10rpx 10rpx 0;
  padding: 12rpx 4rpx 10rpx;
  border-radius: 18rpx; background: #fff; border: 2rpx solid #FFE3D3;
  text-align: center; display: flex; flex-direction: column; align-items: center;
}
.bt-zbtn:nth-child(6n) { margin-right: 0; }
.bt-zbtn.on {
  border-color: #FF5A5F;
  background: linear-gradient(135deg, #FFF6F7, #FFE9EE);
  box-shadow: 0 8rpx 18rpx rgba(255, 90, 95, 0.16);
}
.bt-zcnt {
  position: absolute; top: 6rpx; right: 8rpx;
  font-size: 17rpx; font-weight: 900; color: #BCA89C;
  background: #FFF9FA; border: 1rpx solid #FFE3D3; border-radius: 99rpx;
  padding: 0 7rpx; line-height: 1.6;
}
.bt-zbtn.on .bt-zcnt { color: #fff; background: #FF5A5F; border-color: #FF5A5F; }
.bt-ze { font-size: 36rpx; line-height: 1.15; }
.bt-zn { font-size: 22rpx; font-weight: 900; color: #4A3F3A; margin-top: 2rpx; }
.bt-zbtn.on .bt-zn { color: #FF5A5F; }

.bt-ngrid { display: flex; flex-wrap: wrap; min-height: 84rpx; align-items: center; }
.bt-hint2 { font-size: 23rpx; color: #BCA89C; font-weight: 600; }
.bt-nbtn {
  position: relative;
  min-width: 86rpx; height: 74rpx; line-height: 74rpx;
  text-align: center; margin: 0 10rpx 10rpx 0;
  border-radius: 18rpx; background: #FFF9FA; border: 2rpx solid #FFE3D3;
  font-size: 28rpx; font-weight: 900; color: #4A3F3A;
  font-variant-numeric: tabular-nums;
}
.bt-nbtn.on {
  color: #fff; border-color: #FF5A5F;
  background: linear-gradient(145deg, #FF5A5F, #FF7A5C);
  box-shadow: 0 8rpx 18rpx rgba(255, 90, 95, 0.28);
}
.bt-nbtn.picked::after {
  content: "✓";
  position: absolute; top: -8rpx; right: -8rpx;
  width: 30rpx; height: 30rpx; line-height: 30rpx; text-align: center;
  border-radius: 50%; background: #3FBF8F; color: #fff;
  font-size: 18rpx; border: 3rpx solid #fff; font-weight: 900;
}

.bt-amountrow { display: flex; flex-wrap: wrap; align-items: center; margin-top: 16rpx; }
.bt-amt {
  width: 180rpx; height: 76rpx; padding: 0 18rpx;
  background: #FFF9FA; border: 2rpx solid #FFE3D3; border-radius: 18rpx;
  font-size: 28rpx; font-weight: 900; color: #4A3F3A;
}
.bt-q {
  min-width: 76rpx; height: 64rpx; line-height: 64rpx; text-align: center;
  margin-left: 10rpx; padding: 0 12rpx;
  border: 2rpx solid #FFE3D3; border-radius: 99rpx;
  font-size: 23rpx; font-weight: 800; color: #A9743F; background: #fff;
}
.bt-addbtn {
  margin-left: auto; height: 76rpx; line-height: 76rpx;
  padding: 0 28rpx; border-radius: 99rpx;
  color: #fff; font-size: 26rpx; font-weight: 900;
  background: linear-gradient(135deg, #FF5A5F, #FF7A5C);
  box-shadow: 0 8rpx 20rpx rgba(255, 90, 95, 0.3);
}

/* ---------- 列表 ---------- */
.bt-empty {
  display: flex; flex-direction: column; align-items: center;
  padding: 18rpx 0; color: #BCA89C; font-size: 23rpx; font-weight: 600;
}
.bt-empty.small { padding: 14rpx 0; }
.bt-emptyimg { width: 140rpx; height: 140rpx; margin-bottom: 6rpx; }

.bt-row {
  display: flex; align-items: center;
  background: #FFF9FA; border: 2rpx solid #FFE3D3; border-radius: 18rpx;
  padding: 14rpx 16rpx; margin-bottom: 10rpx;
}
.bt-rowball {
  width: 72rpx; height: 72rpx; line-height: 72rpx; text-align: center;
  border-radius: 16rpx; flex: none;
  background: #fff; border: 2rpx solid #FFE3D3;
  font-size: 26rpx; font-weight: 900; color: #4A3F3A;
  font-variant-numeric: tabular-nums;
}
.bt-rowball.solid {
  color: #fff; border-color: #FF5A5F;
  background: linear-gradient(145deg, #FF5A5F, #FF7A5C);
}
.bt-rowinfo { flex: 1; min-width: 0; margin-left: 14rpx; display: flex; flex-direction: column; }
.bt-rowt1 { font-size: 24rpx; font-weight: 900; color: #4A3F3A; }
.bt-rowt2 { font-size: 20rpx; color: #BCA89C; font-weight: 600; }
.bt-rowamt { font-size: 26rpx; font-weight: 900; color: #FF5A5F; margin-left: 10rpx; }
.bt-x {
  width: 52rpx; height: 52rpx; line-height: 48rpx; text-align: center;
  font-size: 34rpx; color: #BCA89C; margin-left: 8rpx;
}

.bt-total {
  display: flex; align-items: flex-end; justify-content: space-between;
  margin-top: 14rpx; padding-top: 14rpx; border-top: 3rpx dashed #FFE3D3;
}
.bt-tk { display: block; font-size: 21rpx; color: #BCA89C; font-weight: 700; }
.bt-tv { display: block; font-size: 34rpx; font-weight: 900; color: #FF5A5F; font-variant-numeric: tabular-nums; }
.bt-tv2 { display: block; font-size: 30rpx; font-weight: 900; color: #FF5A5F; font-variant-numeric: tabular-nums; }
.bt-tright { text-align: right; }
.bt-thint { font-size: 20rpx; color: #BCA89C; font-weight: 600; }
.bt-avail { font-size: 20rpx; color: #BCA89C; font-weight: 600; margin-top: 4rpx; }

.bt-acts { display: flex; margin-top: 14rpx; }
.bt-act {
  flex: 1; height: 72rpx; line-height: 68rpx; text-align: center;
  border: 2rpx solid #FFE3D3; border-radius: 18rpx;
  font-size: 24rpx; font-weight: 800; color: #A9743F; background: #fff;
  margin-right: 12rpx;
}
.bt-act:last-child { margin-right: 0; }
.bt-act.primary {
  color: #fff; border-color: transparent;
  background: linear-gradient(135deg, #FF5A5F, #FF7A5C);
  box-shadow: 0 8rpx 18rpx rgba(255, 90, 95, 0.26);
}

/* ---------- 钱包 ---------- */
.bt-wallet { display: flex; margin-bottom: 12rpx; }
.bt-wcard {
  flex: 1; background: #fff; border: 2rpx solid #FFD9E3; border-radius: 20rpx;
  padding: 12rpx 16rpx; margin-right: 12rpx;
  box-shadow: 0 6rpx 16rpx rgba(255, 138, 171, 0.12);
}
.bt-wcard:last-child { margin-right: 0; }
.bt-wk { display: block; font-size: 20rpx; color: #BCA89C; font-weight: 700; }
.bt-wv {
  display: block; font-size: 32rpx; font-weight: 900;
  font-variant-numeric: tabular-nums; color: #4A3F3A;
}
.bt-wv.coral { color: #FF5A5F; }
.bt-wv.green { color: #3FBF8F; }
.bt-wv.red { color: #E8543F; }
.bt-walletacts { display: flex; margin-bottom: 16rpx; }
.bt-wbtn {
  flex: 1; height: 68rpx; line-height: 64rpx; text-align: center;
  border: 2rpx solid #FFD9E3; border-radius: 18rpx;
  font-size: 23rpx; font-weight: 800; color: #FF5A5F; background: #FFF9FA;
  margin-right: 12rpx;
}
.bt-wbtn:last-child { margin-right: 0; }
.bt-wbtn.dim { color: #BCA89C; }

/* ---------- 记录 ---------- */
.bt-hist { max-height: 520rpx; }
.bt-hrow {
  display: flex; align-items: center;
  background: #FFF9FA; border: 2rpx solid transparent; border-radius: 16rpx;
  padding: 12rpx 14rpx; margin-bottom: 8rpx;
}
.bt-hrow.win { background: #F1FBF6; border-color: #BFEBD8; }
.bt-hr { width: 92rpx; flex: none; font-size: 20rpx; color: #BCA89C; font-weight: 800; }
.bt-hball {
  width: 58rpx; height: 58rpx; line-height: 58rpx; text-align: center; flex: none;
  border-radius: 14rpx; background: #fff; border: 2rpx solid #FFE3D3;
  font-size: 22rpx; font-weight: 900; color: #4A3F3A;
}
.bt-hrow.win .bt-hball { color: #fff; background: #3FBF8F; border-color: #3FBF8F; }
.bt-hinfo { flex: 1; min-width: 0; margin-left: 12rpx; display: flex; flex-direction: column; }
.bt-hz { font-size: 23rpx; font-weight: 800; color: #4A3F3A; }
.bt-hs { font-size: 20rpx; color: #BCA89C; font-weight: 600; }
.bt-hres { font-size: 24rpx; font-weight: 900; font-variant-numeric: tabular-nums; }
.bt-hres.win { color: #3FBF8F; }
.bt-hres.lose { color: #BCA89C; }

/* ---------- 账本 ---------- */
.bt-statgrid { display: flex; flex-wrap: wrap; }
.bt-st {
  width: calc((100% - 12rpx) / 2);
  background: #FFF9FA; border: 2rpx solid #FBE7DC; border-radius: 18rpx;
  padding: 12rpx 16rpx; margin: 0 12rpx 12rpx 0;
}
.bt-st:nth-child(2n) { margin-right: 0; }
.bt-sk { display: block; font-size: 20rpx; color: #BCA89C; font-weight: 700; }
.bt-sv {
  display: block; font-size: 30rpx; font-weight: 900;
  font-variant-numeric: tabular-nums; color: #4A3F3A;
}
.bt-sv.coral { color: #FF5A5F; }
.bt-sv.green { color: #3FBF8F; }
.bt-sv.red { color: #E8543F; }
.bt-ss { display: block; font-size: 18rpx; color: #BCA89C; font-weight: 600; }

.bt-bars {
  display: flex; align-items: flex-end; height: 76rpx;
  margin-top: 16rpx; padding-top: 8rpx;
  border-top: 2rpx dashed #FFE3D3;
}
.bt-baritem {
  flex: 1; margin-right: 4rpx; border-radius: 4rpx 4rpx 0 0;
  min-height: 5rpx;
}
.bt-baritem:last-child { margin-right: 0; }
.bt-chartcap {
  display: flex; justify-content: space-between;
  font-size: 18rpx; color: #BCA89C; font-weight: 600; margin-top: 6rpx;
}

/* ---------- 数学 ---------- */
.bt-mathbtn {
  font-size: 23rpx; font-weight: 900; color: #A9743F;
  padding: 4rpx 0;
}
.bt-math { display: flex; flex-direction: column; margin-top: 14rpx; }
.bt-math text { font-size: 22rpx; line-height: 1.85; color: #6B5A50; margin-bottom: 10rpx; }
.bt-math .bt-b { color: #FF5A5F; font-weight: 900; }
.bt-code {
  display: block; background: #fff; border: 2rpx solid #FFE3D3;
  border-radius: 10rpx; padding: 8rpx 14rpx; color: #C2494E;
  font-weight: 800; margin-bottom: 10rpx;
}
.bt-last { border-left: 6rpx solid #FF5A5F; padding-left: 14rpx; }

/* ---------- 弹窗 ---------- */
.bt-mask {
  position: fixed; left: 0; top: 0; right: 0; bottom: 0;
  background: rgba(74, 63, 58, 0.45);
  display: flex; align-items: center; justify-content: center;
  padding: 40rpx; z-index: 100;
}
.bt-modal {
  width: 100%; max-width: 620rpx;
  background: linear-gradient(180deg, #FFFDF8, #FFF6F7);
  border: 4rpx solid #FFD9E3; border-radius: 40rpx;
  padding: 32rpx; display: flex; flex-direction: column; align-items: center;
  box-shadow: 0 30rpx 80rpx rgba(120, 70, 60, 0.25);
}
.bt-mtop { width: 150rpx; height: 150rpx; margin-bottom: 8rpx; }
.bt-mtitle { font-size: 34rpx; font-weight: 900; color: #4A3F3A; }
.bt-mdesc {
  font-size: 22rpx; color: #BCA89C; font-weight: 600;
  line-height: 1.7; text-align: center; margin: 10rpx 0 22rpx;
}
.bt-chips { display: flex; flex-wrap: wrap; width: 100%; }
.bt-chip {
  width: calc((100% - 16rpx) / 2);
  margin: 0 16rpx 16rpx 0;
  padding: 18rpx 8rpx; border-radius: 22rpx;
  background: #fff; border: 3rpx solid #FFE3D3;
  display: flex; flex-direction: column; align-items: center;
}
.bt-chip:nth-child(2n) { margin-right: 0; }
.bt-chip.on {
  border-color: #FF5A5F;
  background: linear-gradient(135deg, #FFF4F5, #FFE9EE);
  box-shadow: 0 10rpx 22rpx rgba(255, 90, 95, 0.16);
}
.bt-chipv { font-size: 30rpx; font-weight: 900; color: #4A3F3A; font-variant-numeric: tabular-nums; }
.bt-chip.on .bt-chipv { color: #FF5A5F; }
.bt-chip-sub { font-size: 19rpx; color: #BCA89C; font-weight: 700; margin-top: 2rpx; }

.bt-minput {
  width: 100%; height: 80rpx; margin-top: 8rpx;
  background: #fff; border: 3rpx solid #FFE3D3; border-radius: 20rpx;
  text-align: center; font-size: 28rpx; font-weight: 900; color: #4A3F3A;
}
.bt-primary {
  width: 100%; height: 88rpx; line-height: 88rpx; text-align: center;
  margin-top: 22rpx; border-radius: 99rpx;
  color: #fff; font-size: 28rpx; font-weight: 900;
  background: linear-gradient(135deg, #FF5A5F, #FF7A5C);
  box-shadow: 0 10rpx 24rpx rgba(255, 90, 95, 0.3);
}
.bt-secondary {
  width: 100%; height: 76rpx; line-height: 72rpx; text-align: center;
  margin-top: 14rpx; border-radius: 99rpx;
  color: #A9743F; font-size: 24rpx; font-weight: 800;
  background: #fff; border: 3rpx solid #FFE3D3;
}
.bt-fine { font-size: 19rpx; color: #BCA89C; line-height: 1.7; text-align: center; margin-top: 18rpx; }

.bt-statgrid.ruin { width: 100%; }
.bt-ruinnote {
  font-size: 22rpx; line-height: 1.75; color: #8C4A44; font-weight: 600;
  background: #FFF6F7; border-radius: 18rpx; padding: 16rpx 18rpx;
  margin-top: 6rpx; text-align: left;
}
