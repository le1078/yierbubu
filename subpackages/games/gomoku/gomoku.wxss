.page {
  min-height: 100vh;
  padding: 24rpx;
}

/* ===== 大厅 ===== */
.lobby-hero {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 40rpx;
}

.lobby-masc {
  width: 140rpx;
  height: 140rpx;
}

.lobby-title {
  font-size: 48rpx;
  font-weight: 700;
  color: #E2547A;
  margin: 0 20rpx;
}

.lobby-sub {
  text-align: center;
  color: #A08A80;
  font-size: 26rpx;
  margin-top: 12rpx;
}

.lobby-card {
  margin-top: 48rpx;
  background: #FFFFFF;
  border-radius: 28rpx;
  padding: 40rpx 32rpx;
  box-shadow: 0 8rpx 24rpx rgba(74, 63, 58, 0.08);
}

.big-btn {
  background: #FFF0F4;
  color: #E2547A;
  border-radius: 999rpx;
  text-align: center;
  font-size: 30rpx;
  font-weight: 600;
  padding: 24rpx 0;
}

.big-btn:active { opacity: 0.85; }

.big-btn.primary {
  background: linear-gradient(135deg, #FF8FAB, #FF5A5F);
  color: #FFFFFF;
  box-shadow: 0 8rpx 20rpx rgba(255, 90, 95, 0.28);
}

.divider {
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 36rpx 0 20rpx;
  color: #C4B5AE;
  font-size: 24rpx;
}

.divider::before, .divider::after {
  content: '';
  flex: 1;
  height: 2rpx;
  background: #F0E4DE;
  margin: 0 16rpx;
}

.join-row {
  display: flex;
  gap: 20rpx;
  align-items: stretch;
}

.room-input {
  flex: 1;
  height: 96rpx;
  background: #FFF8F5;
  border: 2rpx solid #FCE8EF;
  border-radius: 999rpx;
  padding: 0 32rpx;
  font-size: 32rpx;
  letter-spacing: 8rpx;
  text-align: center;
  color: #4A3F3A;
  box-sizing: border-box;
  min-height: 96rpx;
}

.join-row .big-btn {
  flex-shrink: 0;
  width: 180rpx;
  height: 96rpx;
  line-height: 96rpx;
  padding: 0;
  box-sizing: border-box;
}

.hint {
  margin-top: 32rpx;
  font-size: 22rpx;
  color: #B9A79F;
  line-height: 1.6;
}

/* ===== 等待 ===== */
.waiting { margin-top: 80rpx; }

.wait-card {
  background: #FFFFFF;
  border-radius: 28rpx;
  padding: 48rpx 32rpx;
  text-align: center;
  box-shadow: 0 8rpx 24rpx rgba(74, 63, 58, 0.08);
}

.wait-title { font-size: 28rpx; color: #A08A80; }

.wait-no {
  font-size: 88rpx;
  font-weight: 700;
  letter-spacing: 16rpx;
  color: #E2547A;
  margin: 16rpx 0;
}

.wait-tip { font-size: 24rpx; color: #B9A79F; }

.wait-avatars {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 40rpx;
  gap: 24rpx;
}

.wa-item { text-align: center; }

.wa-img {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: #FFF0F4;
  border: 4rpx solid #FF8FAB;
}

.wa-img.placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 56rpx;
  color: #D8C8C0;
  background: #F7F1ED;
  border-color: #EADFD9;
}

.wa-name { margin-top: 10rpx; font-size: 24rpx; color: #4A3F3A; }

.wa-item.dim .wa-name { color: #B9A79F; }

.wa-vs { font-size: 32rpx; font-weight: 700; color: #FF8FAB; }

.loading-dots { margin-top: 32rpx; }

.loading-dots .dot {
  display: inline-block;
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #FF8FAB;
  margin: 0 6rpx;
  animation: blink 1.2s infinite;
}

.loading-dots .dot:nth-child(2) { animation-delay: 0.2s; }
.loading-dots .dot:nth-child(3) { animation-delay: 0.4s; }

@keyframes blink {
  0%, 80%, 100% { opacity: 0.2; }
  40% { opacity: 1; }
}

/* ===== 对局 ===== */
.players {
  display: flex;
  align-items: center;
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 20rpx 24rpx;
  box-shadow: 0 6rpx 20rpx rgba(74, 63, 58, 0.08);
}

.p-item {
  text-align: center;
  width: 160rpx;
  border-radius: 20rpx;
  padding: 10rpx 0;
}

.p-item.active {
  background: #FFF0F4;
  box-shadow: inset 0 0 0 2rpx #FF8FAB;
}

.p-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: #FFF0F4;
}

.p-name { font-size: 24rpx; font-weight: 600; color: #4A3F3A; margin-top: 4rpx; }
.p-color { font-size: 20rpx; color: #A08A80; }

.p-mid { flex: 1; text-align: center; }

.p-status { font-size: 28rpx; font-weight: 600; color: #E2547A; }
.p-room { font-size: 20rpx; color: #B9A79F; margin-top: 4rpx; }

.poke-toast {
  position: fixed;
  top: 200rpx;
  left: 50%;
  transform: translateX(-50%);
  background: rgba(74, 63, 58, 0.92);
  color: #FFFFFF;
  padding: 20rpx 40rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  z-index: 99;
  animation: pokeIn 0.25s ease;
}

@keyframes pokeIn {
  from { transform: translateX(-50%) scale(0.8); opacity: 0; }
  to { transform: translateX(-50%) scale(1); opacity: 1; }
}

.board-wrap {
  margin-top: 24rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 20rpx;
  box-shadow: 0 6rpx 20rpx rgba(74, 63, 58, 0.08);
}

.board {
  display: block;
  border-radius: 16rpx;
}

.end-banner {
  margin-top: 24rpx;
  background: linear-gradient(135deg, #FFE3EC, #FFF3D9);
  border-radius: 24rpx;
  padding: 32rpx;
  text-align: center;
}

.end-text { font-size: 40rpx; font-weight: 700; color: #E2547A; }

.actions {
  margin-top: 24rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  justify-content: center;
}

.act-btn {
  background: #FFFFFF;
  border: 2rpx solid #FCE8EF;
  color: #4A3F3A;
  border-radius: 999rpx;
  padding: 18rpx 32rpx;
  font-size: 26rpx;
}

.act-btn:active { opacity: 0.8; }

.act-btn.primary {
  background: linear-gradient(135deg, #FF8FAB, #FF5A5F);
  color: #FFFFFF;
  border: none;
}

.act-btn.ghost { color: #B9A79F; }

.act-btn.disabled { opacity: 0.4; }

/* ===== 弹层 ===== */
.modal-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
}

.modal {
  width: 560rpx;
  background: #FFFFFF;
  border-radius: 28rpx;
  padding: 48rpx 40rpx;
  text-align: center;
}

.m-title { font-size: 32rpx; font-weight: 700; color: #4A3F3A; }
.m-desc { margin-top: 16rpx; font-size: 26rpx; color: #A08A80; }

.m-btns {
  display: flex;
  gap: 24rpx;
  margin-top: 40rpx;
}

.m-btn {
  flex: 1;
  border-radius: 999rpx;
  padding: 22rpx 0;
  font-size: 28rpx;
  font-weight: 600;
}

.m-btn.ghost {
  background: #F7F1ED;
  color: #A08A80;
}

.m-btn.primary {
  background: linear-gradient(135deg, #FF8FAB, #FF5A5F);
  color: #FFFFFF;
}

/* ===== 表情面板 ===== */
.emoji-panel {
  margin-top: 16rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 24rpx;
  box-shadow: 0 6rpx 20rpx rgba(74, 63, 58, 0.08);
}

.emoji-row {
  display: flex;
  justify-content: space-around;
}

.emoji-item {
  text-align: center;
  padding: 10rpx;
}

.emoji-item:active { transform: scale(1.15); }

.emoji-icon { font-size: 56rpx; display: block; }

.emoji-label { font-size: 20rpx; color: #A08A80; display: block; margin-top: 6rpx; }

/* 表情飞行动画 */
.emoji-fly {
  position: fixed;
  top: 40%;
  left: 50%;
  font-size: 100rpx;
  z-index: 200;
  animation: emojiFly 1.8s ease-out forwards;
  pointer-events: none;
}

@keyframes emojiFly {
  0%   { transform: translate(-50%, 0) scale(0.5) rotate(0deg); opacity: 0; }
  20%  { opacity: 1; }
  60%  { transform: translate(-50%, -300rpx) scale(1.3) rotate(360deg); opacity: 1; }
  100% { transform: translate(-50%, -500rpx) scale(0.8) rotate(720deg); opacity: 0; }
}

/* ===== 聊天区 ===== */
.chat-area {
  margin-top: 24rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 20rpx;
  box-shadow: 0 6rpx 20rpx rgba(74, 63, 58, 0.08);
}

.chat-list {
  max-height: 240rpx;
  min-height: 80rpx;
}

.chat-msg {
  display: flex;
  margin-bottom: 12rpx;
}

.chat-msg.mine { justify-content: flex-end; }

.chat-bubble {
  max-width: 70%;
  padding: 14rpx 22rpx;
  border-radius: 24rpx;
  font-size: 26rpx;
  line-height: 1.4;
  word-break: break-all;
}

.chat-msg.mine .chat-bubble {
  background: linear-gradient(135deg, #FF8FAB, #FF5A5F);
  color: #FFFFFF;
  border-bottom-right-radius: 6rpx;
}

.chat-msg.theirs .chat-bubble {
  background: #F5F0EB;
  color: #4A3F3A;
  border-bottom-left-radius: 6rpx;
}

.chat-emoji { font-size: 64rpx; }

.chat-input-row {
  display: flex;
  gap: 16rpx;
  margin-top: 16rpx;
  align-items: center;
}

.chat-input {
  flex: 1;
  height: 72rpx;
  background: #FFF8F5;
  border: 2rpx solid #FCE8EF;
  border-radius: 999rpx;
  padding: 0 28rpx;
  font-size: 26rpx;
  color: #4A3F3A;
  box-sizing: border-box;
}

.chat-send {
  flex-shrink: 0;
  background: linear-gradient(135deg, #FF8FAB, #FF5A5F);
  color: #FFFFFF;
  border-radius: 999rpx;
  padding: 0 32rpx;
  height: 72rpx;
  line-height: 72rpx;
  font-size: 26rpx;
  font-weight: 600;
}

.chat-send:active { opacity: 0.85; }

/* 底部安全区：iPhone 手势条 / Android 导航条会压住底部的按键与操作行 */
.page {
  padding-bottom: calc(24rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}
