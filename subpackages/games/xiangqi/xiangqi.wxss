.page {
  min-height: 100vh;
  padding: 24rpx;
}

/* ===== 模式选择 ===== */
.menu-hero {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 40rpx;
}

.menu-title {
  font-size: 48rpx;
  font-weight: 700;
  color: #E2547A;
}

.menu-sub {
  text-align: center;
  color: #A08A80;
  font-size: 26rpx;
  margin-top: 12rpx;
}

.menu-card {
  margin-top: 40rpx;
  background: #FFFFFF;
  border-radius: 28rpx;
  padding: 28rpx;
  box-shadow: 0 8rpx 24rpx rgba(74, 63, 58, 0.08);
}

.opt {
  display: flex;
  align-items: center;
  background: #FFF8F5;
  border: 2rpx solid #FCE8EF;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.opt.primary {
  border-color: #FF8FAB;
  background: #FFF0F4;
}

.opt:active { opacity: 0.85; }

.opt-icon {
  font-size: 48rpx;
  margin-right: 20rpx;
}

.opt-body { flex: 1; }

.opt-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #6B4A52;
}

.opt.primary .opt-name { color: #E2547A; }

.opt-desc {
  font-size: 24rpx;
  color: #A08A80;
  margin-top: 6rpx;
}

.menu-tip {
  text-align: center;
  color: #C4B5AE;
  font-size: 22rpx;
  margin-top: 24rpx;
}

/* ===== 联机大厅 ===== */
.lobby-card {
  margin-top: 48rpx;
  background: #FFFFFF;
  border-radius: 28rpx;
  padding: 40rpx 32rpx;
  box-shadow: 0 8rpx 24rpx rgba(74, 63, 58, 0.08);
}

.big-btn {
  background: #FFF0F4;
  color: #E2547A;
  border-radius: 999rpx;
  text-align: center;
  font-size: 30rpx;
  font-weight: 600;
  padding: 24rpx 0;
}

.big-btn:active { opacity: 0.85; }

.big-btn.primary {
  background: linear-gradient(135deg, #FF8FAB, #FF5A5F);
  color: #FFFFFF;
  box-shadow: 0 8rpx 20rpx rgba(255, 90, 95, 0.28);
}

.big-btn.ghost {
  background: #FFF8F5;
  color: #A08A80;
  margin-top: 20rpx;
}

.divider {
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 36rpx 0 20rpx;
  color: #C4B5AE;
  font-size: 24rpx;
}

.divider::before, .divider::after {
  content: '';
  flex: 1;
  height: 2rpx;
  background: #F0E4DE;
  margin: 0 16rpx;
}

.join-row {
  display: flex;
  gap: 20rpx;
  align-items: stretch;
}

.room-input {
  flex: 1;
  height: 96rpx;
  background: #FFF8F5;
  border: 2rpx solid #FCE8EF;
  border-radius: 999rpx;
  padding: 0 32rpx;
  font-size: 32rpx;
  letter-spacing: 8rpx;
}

.hint {
  color: #A08A80;
  font-size: 22rpx;
  margin-top: 24rpx;
  line-height: 1.6;
}

/* ===== 等待 ===== */
.wait-card {
  margin-top: 60rpx;
  background: #FFFFFF;
  border-radius: 28rpx;
  padding: 48rpx 32rpx;
  box-shadow: 0 8rpx 24rpx rgba(74, 63, 58, 0.08);
  text-align: center;
}

.wait-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #6B4A52;
}

.wait-no {
  font-size: 72rpx;
  font-weight: 700;
  color: #E2547A;
  letter-spacing: 12rpx;
  margin: 24rpx 0 12rpx;
}

.wait-tip {
  font-size: 24rpx;
  color: #A08A80;
}

.wait-side {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 40rpx;
}

.ws-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  min-width: 140rpx;
}

.ws-item.dim { opacity: 0.5; }

.ws-dot {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
}

.ws-dot.red {
  background: radial-gradient(circle at 35% 35%, #E74C3C, #922B21);
}

.ws-dot.black {
  background: radial-gradient(circle at 35% 35%, #5D6D7E, #1B2631);
}

.ws-dot.placeholder {
  background: #F0E4DE;
  color: #A08A80;
  font-size: 32rpx;
  text-align: center;
  line-height: 48rpx;
}

.ws-name {
  font-size: 24rpx;
  color: #6B4A52;
  margin-top: 10rpx;
  font-weight: 600;
}

.ws-vs {
  font-size: 28rpx;
  font-weight: 700;
  color: #FF8FAB;
  margin: 0 24rpx;
}

.loading-dots {
  display: flex;
  gap: 10rpx;
  justify-content: center;
  margin-top: 40rpx;
}

.loading-dots .dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #FF8FAB;
  animation: blink 1.2s infinite;
}

.loading-dots .dot:nth-child(2) { animation-delay: 0.2s; }
.loading-dots .dot:nth-child(3) { animation-delay: 0.4s; }

@keyframes blink {
  0%, 60%, 100% { opacity: 0.25; }
  30% { opacity: 1; }
}

/* ===== 对局 ===== */
.bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 16rpx 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(74, 63, 58, 0.06);
}

.bar-side {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 8rpx 14rpx;
  border-radius: 16rpx;
  border: 2rpx solid transparent;
  min-width: 120rpx;
}

.bar-side.on {
  border-color: #FF8FAB;
  background: #FFF6F8;
}

.side-dot {
  width: 28rpx;
  height: 28rpx;
  border-radius: 50%;
}

.side-dot.red {
  background: radial-gradient(circle at 35% 35%, #E74C3C, #922B21);
}

.side-dot.black {
  background: radial-gradient(circle at 35% 35%, #5D6D7E, #1B2631);
}

.side-name {
  font-size: 24rpx;
  font-weight: 600;
  color: #6B4A52;
}

.bar-mid { flex: 1; text-align: center; }

.bar-status {
  font-size: 26rpx;
  color: #E2547A;
  font-weight: 600;
}

.bar-meta {
  font-size: 20rpx;
  color: #A08A80;
  margin-top: 4rpx;
}

.board-wrap {
  position: relative;
  margin-top: 20rpx;
  display: flex;
  justify-content: center;
}

.board {
  border-radius: 16rpx;
  box-shadow: 0 6rpx 20rpx rgba(74, 63, 58, 0.12);
}

.sel-tip {
  text-align: center;
  font-size: 22rpx;
  color: #A08A80;
  margin-top: 12rpx;
}

.end-banner {
  margin-top: 20rpx;
  background: linear-gradient(135deg, #FF8FAB, #FF5A5F);
  border-radius: 24rpx;
  padding: 24rpx;
  text-align: center;
  box-shadow: 0 8rpx 20rpx rgba(255, 90, 95, 0.28);
}

.end-text {
  font-size: 36rpx;
  font-weight: 700;
  color: #FFFFFF;
}

.actions {
  display: flex;
  gap: 14rpx;
  margin-top: 20rpx;
}

.act-btn {
  flex: 1;
  background: #FFFFFF;
  color: #E2547A;
  border-radius: 999rpx;
  text-align: center;
  font-size: 26rpx;
  font-weight: 600;
  padding: 20rpx 0;
  box-shadow: 0 4rpx 12rpx rgba(74, 63, 58, 0.06);
}

.act-btn:active { opacity: 0.85; }

.act-btn.ghost {
  background: #FFF8F5;
  color: #A08A80;
}

/* ===== 聊天 ===== */
.chat-area {
  margin-top: 20rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(74, 63, 58, 0.06);
}

.chat-list {
  max-height: 220rpx;
}

.chat-msg {
  display: flex;
  margin-bottom: 12rpx;
}

.chat-msg.mine { justify-content: flex-end; }

.chat-bubble {
  background: #FFF0F4;
  color: #6B4A52;
  font-size: 24rpx;
  padding: 12rpx 20rpx;
  border-radius: 20rpx;
  max-width: 420rpx;
  word-break: break-all;
}

.chat-msg.mine .chat-bubble {
  background: linear-gradient(135deg, #FF8FAB, #FF5A5F);
  color: #FFFFFF;
}

.chat-input-row {
  display: flex;
  gap: 16rpx;
  margin-top: 16rpx;
  align-items: center;
}

.chat-input {
  flex: 1;
  height: 72rpx;
  background: #FFF8F5;
  border: 2rpx solid #FCE8EF;
  border-radius: 999rpx;
  padding: 0 24rpx;
  font-size: 26rpx;
}

.chat-send {
  background: linear-gradient(135deg, #FF8FAB, #FF5A5F);
  color: #FFFFFF;
  font-size: 26rpx;
  font-weight: 600;
  padding: 14rpx 28rpx;
  border-radius: 999rpx;
}

/* ===== 戳一戳 / 扔水果 / 请求等待 ===== */
.poke-banner {
  margin-top: 16rpx;
  background: #FFF3E6;
  border: 2rpx solid #FFB35C;
  color: #C8641E;
  border-radius: 18rpx;
  padding: 16rpx 28rpx;
  text-align: center;
  font-size: 26rpx;
  animation: poke-shake 0.4s ease;
}

@keyframes poke-shake {
  0%, 100% { transform: translateX(0); }
  25% { transform: translateX(-10rpx); }
  75% { transform: translateX(10rpx); }
}

.req-tip {
  margin-top: 12rpx;
  text-align: center;
  font-size: 24rpx;
  color: #A08A80;
}

.fruit-btns {
  display: flex;
  align-items: center;
  gap: 4rpx;
}

.fruit {
  font-size: 40rpx;
  padding: 4rpx;
}

.emoji-fly {
  position: fixed;
  left: -80rpx;
  top: 40%;
  font-size: 80rpx;
  z-index: 99;
  pointer-events: none;
  animation: fly-across 1.2s ease-in forwards;
}

@keyframes fly-across {
  from { transform: translateX(0) rotate(0deg); }
  to { transform: translateX(900rpx) rotate(360deg); }
}

/* ===== 人机设置页布局（与马里奥/五子棋同一套视觉） =====
   这几个 class 之前在 wxml 里用了但 wxss 里没有定义：难度/执子选项
   会一条条竖着堆、标题没有层级，跟另外两个游戏长得不一样。 */
.lobby-hero {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 40rpx;
}

.sec-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #6B4A52;
  margin-bottom: 20rpx;
}

.opt-row {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

/* 底部安全区：iPhone 手势条 / Android 导航条会压住底部的按键与操作行 */
.page {
  padding-bottom: calc(24rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}
