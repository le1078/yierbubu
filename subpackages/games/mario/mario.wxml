<view class="page {{landscape ? 'land' : ''}}">

  <!-- ===== 菜单 ===== -->
  <view wx:if="{{stage === 'menu'}}" class="menu">
    <view class="menu-hero">
      <view class="menu-title">🍄 小笨马里奥</view>
    </view>
    <view class="menu-sub">双人联机闯关 · 五关 + Boss 战</view>

    <view class="menu-card">
      <view class="sec-title">玩法</view>
      <view class="opt-row">
        <view class="opt {{coop ? 'on' : ''}}" bindtap="toggleCoop">
          <view class="opt-name">🤝 合作</view>
          <view class="opt-desc">双方到终点才过关</view>
        </view>
        <view class="opt {{!coop ? 'on' : ''}}" bindtap="toggleCoop">
          <view class="opt-name">🏁 竞速</view>
          <view class="opt-desc">先到终点者胜</view>
        </view>
      </view>

      <view class="big-btn primary" bindtap="createRoom">🌐 创建联机房间</view>
      <view class="divider"><text>或加入好友的房间</text></view>
      <view class="join-row">
        <input class="room-input" type="text" maxlength="4" placeholder="输入4位房间号"
          value="{{roomNoInput}}" bindinput="onRoomNoInput"/>
        <view class="big-btn" bindtap="joinRoom">加入</view>
      </view>
      <view class="big-btn ghost" bindtap="startSolo">🎮 单机试玩</view>
    </view>

    <view class="menu-tip">
      💡 创建后点右上角「···」转发给微信好友，TA 点卡片直接进房<br/>
      ⚠️ 联机模式下对方位置有约 0.3 秒延迟（云推送限制），手感已做预测优化
    </view>
  </view>

  <!-- ===== 等待对手 ===== -->
  <view wx:if="{{stage === 'waiting'}}" class="waiting">
    <view class="wait-card">
      <view class="wait-title">房间已创建</view>
      <view class="wait-no">{{roomNo}}</view>
      <view class="wait-tip">把房间号发给好朋友，或点右上角转发邀请</view>
      <view class="wait-mode">{{coop ? '🤝 合作闯关' : '🏁 竞速模式'}}</view>
      <view class="loading-dots"><text class="dot"></text><text class="dot"></text><text class="dot"></text></view>
      <view class="big-btn ghost" bindtap="leaveRoom">🚪 离开</view>
    </view>
  </view>

  <!-- ===== 对局（横屏：左画面 + 右按键） ===== -->
  <view wx:if="{{stage === 'playing' || stage === 'ended'}}" class="game">

    <view class="hud">
      <view class="hud-side">
        <image class="hud-avatar" src="/subpackages/games/mario/img/avatar_a.gif" mode="aspectFit"/>
        <text class="hud-name">P1</text>
        <text class="hud-lives">❤️{{p1Lives}}</text>
      </view>
      <view class="hud-mid">
        <view class="hud-status">{{statusText}}</view>
        <view class="hud-meta">{{metaText}} · 同步 {{syncMs}}ms</view>
      </view>
      <view class="hud-side">
        <image class="hud-avatar" src="/subpackages/games/mario/img/avatar_b.gif" mode="aspectFit"/>
        <text class="hud-name">P2</text>
        <text class="hud-lives">❤️{{p2Lives}}</text>
      </view>
    </view>

    <view class="stage-row">
      <!-- 游戏画面 -->
      <view class="stage">
        <canvas type="2d" id="gcanvas" class="gcanvas"
          style="width: {{canvasW}}px; height: {{canvasH}}px;"
          disable-scroll="true"></canvas>

        <!-- 玩家形象：canvas 不支持 GIF 动画，只能用 image 组件叠加。
             位置由 JS 每帧同步（_syncAvatars）。face=-1 时水平翻转，
             让角色朝左走时形象也朝左（正版马里奥的行为）。 -->
        <image wx:if="{{!av1.hidden}}" class="avatar av1 {{av1.face < 0 ? 'flip' : ''}}" src="/subpackages/games/mario/img/avatar_a.gif" mode="aspectFit"
          style="left: {{av1.left}}px; top: {{av1.top}}px; width: {{av1.w}}px; height: {{av1.h}}px;"/>
        <image wx:if="{{!av2.hidden}}" class="avatar av2 {{av2.face < 0 ? 'flip' : ''}}" src="/subpackages/games/mario/img/avatar_b.gif" mode="aspectFit"
          style="left: {{av2.left}}px; top: {{av2.top}}px; width: {{av2.w}}px; height: {{av2.h}}px;"/>

        <!-- 结算浮层 -->
        <view wx:if="{{stage === 'ended'}}" class="end-mask">
          <view class="end-card">
            <view class="end-text">{{winText}}</view>
            <view class="end-btns">
              <view class="e-btn primary" bindtap="nextLevel">下一关 →</view>
              <view class="e-btn" bindtap="restart">重玩本关</view>
              <view class="e-btn ghost" bindtap="leaveRoom">离开</view>
            </view>
          </view>
        </view>
      </view>
    </view>

    <!-- 虚拟按键：竖屏时在画面下方，左右分置，拇指好按 -->
    <view class="pad">
      <view class="pad-dpad">
        <view class="p-btn" data-k="l" bindtouchstart="onBtnDown" bindtouchend="onBtnUp" bindtouchcancel="onBtnUp">◀</view>
        <view class="p-btn" data-k="r" bindtouchstart="onBtnDown" bindtouchend="onBtnUp" bindtouchcancel="onBtnUp">▶</view>
      </view>
      <view class="pad-act">
        <view class="p-btn run" data-k="run" bindtouchstart="onBtnDown" bindtouchend="onBtnUp" bindtouchcancel="onBtnUp">跑</view>
        <view class="p-btn jump" data-k="u" bindtouchstart="onBtnDown" bindtouchend="onBtnUp" bindtouchcancel="onBtnUp">跳</view>
      </view>
    </view>

  </view>
</view>
