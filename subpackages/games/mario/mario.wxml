<view class="page {{landscape ? 'land' : ''}}">

  <!-- ===== 菜单 ===== -->
  <view wx:if="{{stage === 'menu'}}" class="menu">
    <view class="menu-hero">
      <view class="menu-title">🍄 小笨马里奥</view>
    </view>
    <view class="menu-sub">双人联机闯关 · 管道金币房 · 星星/1UP · 五关 + Boss 战</view>

    <view class="menu-card">
      <view class="sec-title">玩法</view>
      <view class="opt-row">
        <view class="opt {{coop ? 'on' : ''}}" bindtap="toggleCoop">
          <view class="opt-name">🤝 合作</view>
          <view class="opt-desc">双方到终点才过关 · 道具共享</view>
        </view>
        <view class="opt {{!coop ? 'on' : ''}}" bindtap="toggleCoop">
          <view class="opt-name">🏁 竞速</view>
          <view class="opt-desc">先到终点者胜（单机有电脑）</view>
        </view>
      </view>
      <view class="opt-row">
        <view class="opt {{infiniteLives ? 'on' : ''}}" bindtap="toggleInfiniteLives">
          <view class="opt-name">💕 无限生命</view>
          <view class="opt-desc">死亡不减命，随便玩</view>
        </view>
        <view class="opt {{muted ? '' : 'on'}}" bindtap="toggleMute">
          <view class="opt-name">{{muted ? '🔇 静音' : '🔊 音效'}}</view>
          <view class="opt-desc">8-bit 芯片音效</view>
        </view>
      </view>

      <view class="big-btn primary" bindtap="createRoom">🌐 创建联机房间</view>
      <view class="divider"><text>或加入好友的房间</text></view>
      <view class="join-row">
        <input class="room-input" type="text" maxlength="4" placeholder="输入4位房间号"
          value="{{roomNoInput}}" bindinput="onRoomNoInput"/>
        <view class="big-btn" bindtap="joinRoom">加入</view>
      </view>
      <view class="big-btn ghost" bindtap="startSolo">🎮 单机试玩</view>
    </view>

    <view class="menu-tip">
      💡 创建后点右上角「···」转发给微信好友，TA 点卡片直接进房<br/>
      ▼ 站在管道口按向下键，可以进入地下金币房；💬 联机时可以聊天，气泡会出现在头顶<br/>
      ⚡ 手机开「开发调试」走自建加速通道（HUD 显示 ⚡ms）；不开也能玩，走云端稍慢<br/>
      🔧 加入失败？请把云数据库房间集合权限设为「所有用户可读写」
    </view>
  </view>

  <!-- ===== 等待对手 ===== -->
  <view wx:if="{{stage === 'waiting'}}" class="waiting">
    <view class="wait-card">
      <view class="wait-title">房间已创建</view>
      <view class="wait-no">{{roomNo}}</view>
      <view class="wait-tip">把房间号发给好朋友，或点右上角转发邀请</view>
      <view class="wait-mode">{{coop ? '🤝 合作闯关' : '🏁 竞速模式'}}</view>
      <view class="loading-dots"><text class="dot"></text><text class="dot"></text><text class="dot"></text></view>
      <view class="big-btn ghost" bindtap="leaveRoom">🚪 离开</view>
    </view>
  </view>

  <!-- ===== 对局（横屏：左画面 + 右按键） ===== -->
  <view wx:if="{{stage === 'playing' || stage === 'ended'}}" class="game">

    <view class="hud">
      <view class="hud-side">
        <image class="hud-avatar" src="/subpackages/games/mario/img/avatar_a.gif" mode="aspectFit"/>
        <view class="hud-info">
          <view class="hud-row"><text class="hud-name">P1</text><text class="hud-lives">❤️{{p1Lives}}</text></view>
          <view class="hud-row"><text class="hud-score">{{p1Score}}</text><text class="hud-coin">🪙{{p1Coins}}</text></view>
        </view>
      </view>
      <view class="hud-mid">
        <view class="hud-timer {{timeLeft <= 60 ? 'urgent' : ''}}">⏱ {{timeLeft}}</view>
        <view wx:if="{{raceText}}" class="hud-race">{{raceText}}</view>
        <view class="hud-meta">{{statusText}} · {{metaText}}<text wx:if="{{syncText}}" class="hud-sync"> · {{syncText}}</text></view>
      </view>
      <view wx:if="{{mode === 'online' || !coop}}" class="hud-side">
        <image class="hud-avatar" src="/subpackages/games/mario/img/avatar_b.gif" mode="aspectFit"/>
        <view class="hud-info">
          <view class="hud-row"><text class="hud-name">P2</text><text class="hud-lives">❤️{{p2Lives}}</text></view>
          <view class="hud-row"><text class="hud-score">{{p2Score}}</text><text class="hud-coin">🪙{{p2Coins}}</text></view>
        </view>
      </view>
    </view>

    <view class="stage-row">
      <!-- 游戏画面 -->
      <view class="stage">
        <canvas type="2d" id="gcanvas" class="gcanvas"
          style="width: {{canvasW}}px; height: {{canvasH}}px;"
          disable-scroll="true"></canvas>

        <!-- 玩家形象直接画在 canvas 上（GIF 抽帧 PNG）。
             不再用 <image> 叠加：部分基础库会把原生 canvas 盖在 image 上层，
             表现为只看得见名牌、看不见角色。 -->

        <!-- 聊天：消息会以气泡挂在角色头顶几秒 -->
        <view wx:if="{{stage === 'playing' && mode === 'online' && !showChat}}" class="chat-fab" bindtap="toggleChatPanel">💬</view>
        <view wx:if="{{stage === 'playing'}}" class="mute-fab {{muted ? 'off' : ''}}" bindtap="toggleMute">{{muted ? '🔇' : '🔊'}}</view>
        <view wx:if="{{showChat}}" class="chat-panel">
          <view class="chat-quick">
            <view class="chat-q" data-t="等等我！" bindtap="quickChat">等等我！</view>
            <view class="chat-q" data-t="来啊！" bindtap="quickChat">来啊！</view>
            <view class="chat-q" data-t="哈哈" bindtap="quickChat">哈哈</view>
            <view class="chat-q" data-t="好样的！" bindtap="quickChat">好样的！</view>
          </view>
          <view class="chat-row">
            <input class="chat-in" placeholder="说点什么，气泡会出现在头顶…" value="{{chatInput}}"
              bindinput="onChatInput" maxlength="20" confirm-type="send" bindconfirm="sendChat"/>
            <view class="chat-send" bindtap="sendChat">发</view>
            <view class="chat-close" bindtap="toggleChatPanel">✕</view>
          </view>
        </view>

        <!-- 结算浮层 -->
        <view wx:if="{{stage === 'ended'}}" class="end-mask">
          <view class="end-card">
            <view class="end-text">{{winText}}</view>
            <view class="end-btns">
              <view class="e-btn primary" bindtap="nextLevel">下一关 →</view>
              <view class="e-btn" bindtap="restart">重玩本关</view>
              <view class="e-btn ghost" bindtap="leaveRoom">离开</view>
            </view>
          </view>
        </view>
      </view>
    </view>

    <!-- 虚拟按键：竖屏时在画面下方，左右分置，拇指好按 -->
    <view class="pad">
      <view class="pad-dpad">
        <view class="p-btn" data-k="l" bindtouchstart="onBtnDown" bindtouchend="onBtnUp" bindtouchcancel="onBtnUp">◀</view>
        <view class="p-btn down" data-k="d" bindtouchstart="onBtnDown" bindtouchend="onBtnUp" bindtouchcancel="onBtnUp">▼</view>
        <view class="p-btn" data-k="r" bindtouchstart="onBtnDown" bindtouchend="onBtnUp" bindtouchcancel="onBtnUp">▶</view>
      </view>
      <view class="pad-act">
        <view class="p-btn run" data-k="run" bindtouchstart="onBtnDown" bindtouchend="onBtnUp" bindtouchcancel="onBtnUp">跑/火</view>
        <view class="p-btn jump" data-k="u" bindtouchstart="onBtnDown" bindtouchend="onBtnUp" bindtouchcancel="onBtnUp">跳</view>
      </view>
    </view>

  </view>
</view>
